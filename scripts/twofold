#!/bin/bash
# twofold — open two files or two folders in Twofold.
#
#   twofold A B          compare A and B in a new window
#   twofold DIR          show what has changed in the Git repository at DIR since the last commit
#   twofold --wait A B   block until the window closes (for git difftool)
#   twofold --wait --base BASE --output MERGED LOCAL REMOTE
#                        three-way merge of LOCAL and REMOTE, saved to MERGED (for git mergetool)
#   twofold              open the start window
set -euo pipefail

DEFAULT_APP=""
APP="${TWOFOLD_APP:-$DEFAULT_APP}"
# The copy inside an app bundle (Contents/Resources) launches that app.
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -z "$APP" && "$SELF_DIR" == *.app/Contents/Resources ]]; then
    APP="${SELF_DIR%/Contents/Resources}"
fi
if [[ -z "$APP" ]]; then
    for candidate in "/Applications/Twofold.app" "$HOME/Applications/Twofold.app"; do
        if [[ -d "$candidate" ]]; then APP="$candidate"; break; fi
    done
fi
if [[ ! -d "$APP" ]]; then
    echo "twofold: Twofold.app not found. Run 'make install' or set TWOFOLD_APP." >&2
    exit 1
fi

usage() {
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
}

# A path as the app must see it: absolute, since `open` does not pass on the working directory.
absolute() {
    if [[ -d "$1" ]]; then
        (cd "$1" && pwd)
    else
        echo "$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
    fi
}

WAIT=0
PATHS=()
EXTRA=()
while (($#)); do
    arg="$1"
    shift
    case "$arg" in
        -w|--wait) WAIT=1 ;;
        -h|--help) usage; exit 0 ;;
        --base)
            # Git names a base file even when the two sides share no ancestor; then it does not exist.
            if (($#)) && [[ -f "$1" ]]; then EXTRA+=(--base "$(absolute "$1")"); fi
            (($#)) && shift
            ;;
        --output)
            if ! (($#)) || [[ ! -d "$(dirname "$1")" ]]; then
                echo "twofold: --output needs a file in an existing folder" >&2
                exit 1
            fi
            EXTRA+=(--output "$(absolute "$1")")
            shift
            ;;
        *)
            if [[ ! -e "$arg" ]]; then
                echo "twofold: no such file or directory: $arg" >&2
                exit 1
            fi
            PATHS+=("$(absolute "$arg")")
            ;;
    esac
done

OPEN_ARGS=(-n -a "$APP")
if [[ $WAIT == 1 ]]; then OPEN_ARGS=(-W "${OPEN_ARGS[@]}"); fi

if ((${#PATHS[@]})); then
    exec open "${OPEN_ARGS[@]}" --args ${EXTRA[@]+"${EXTRA[@]}"} "${PATHS[@]}"
else
    exec open "${OPEN_ARGS[@]}"
fi
